# OpenRouter API Key for free open-source models (e.g., nousresearch/hermes-3-llama-3.1-405b:free).
# Configure securely via the Secrets panel in AI Studio or GitHub Actions Secrets.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# Groq API Key (optional) for fast free Llama 3.3 / 3.1 inference.
GROQ_API_KEY=MY_GROQ_API_KEY
